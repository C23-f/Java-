### 添加收藏
POST http://localhost:8080/api/favorite/add
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJhZG1pbiIsInJvbGVDb2RlIjoiYWRtaW4iLCJpYXQiOjE3ODkzMDEyNzcsImV4cCI6MTc4OTM4NzY3N30.2h2qP_MYERpBfVdt_cUFAqTOl_OP7ObiXb10YJQPZDY

{
"userId":1,
"objectType":"community",
"objectId":2,
"remark":"喜欢这个小区"
}



### 取消收藏
DELETE http://localhost:8080/api/favorite/delete?userId=1&objectType=community&objectId=2
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIiwidXNlcm5hbWUiOiJhZG1pbiIsInJvbGVDb2RlIjoiYWRtaW4iLCJpYXQiOjE3ODkzMDEyNzcsImV4cCI6MTc4OTM4NzY3N30.2h2qP_MYERpBfVdt_cUFAqTOl_OP7ObiXb10YJQPZDY

