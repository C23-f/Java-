<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.EvaluationMapper">
<insert id="insert" parameterType="com.example.springboot.entity.Evaluation">
    INSERT INTO [evaluation] (object_type,object_id,user_id,score,content,status)
    VALUES(#{objectType},#{objectId},#{userId},#{score},#{content},#{status})
</insert>


    <!-- 新增评价审核更新语句 -->
   <update id="auditEvaluation">
    UPDATE evaluation
    SET status = #{status},
        reject_reason = #{rejectReason},
        auditor_id = #{auditorId},
        audit_time = GETDATE()
    WHERE id = #{id}
</update>

<select id="selectEvaluationList" resultType="com.example.springboot.entity.Evaluation">
    SELECT id,object_type,object_id,user_id,score,content,status,reject_reason,create_time,audit_time,auditor_id
    FROM evaluation
    <where>
        <if test="status != null">
            status = #{status}
        </if>
    </where>
    ORDER BY create_time DESC
</select>

    <!-- 根据ID查询评价详情 -->
    <select id="selectById" resultType="com.example.springboot.entity.Evaluation">
        SELECT id,object_type,object_id,user_id,score,content,status,reject_reason,create_time,audit_time,auditor_id
        FROM [evaluation]
        WHERE id = #{id}
    </select>

    <!-- 删除评价 -->
    <delete id="deleteById">
        DELETE FROM [evaluation] WHERE id = #{id}
    </delete>

</mapper>
