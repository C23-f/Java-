<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.FavoriteMapper">

    <insert id="insertCustom">
        INSERT INTO favorite (user_id,object_type,object_id,remark,create_time)
        VALUES (#{userId},#{objectType},#{objectId},#{remark},GETDATE())
    </insert>

    <delete id="deleteByUserAndObj">
        DELETE FROM favorite
        WHERE user_id = #{userId} AND object_type = #{objectType} AND object_id = #{objectId}
    </delete>

    <select id="selectByUserId" resultType="com.example.springboot.entity.Favorite">
        SELECT * FROM favorite WHERE user_id = #{userId}
    </select>

    <select id="selectExist" resultType="com.example.springboot.entity.Favorite">
        SELECT * FROM favorite
        WHERE user_id = #{userId} AND object_type = #{objectType} AND object_id = #{objectId}
    </select>

    <!-- 批量删除收藏（仅限当前用户自己的收藏记录） -->
    <delete id="deleteBatch">
        DELETE FROM favorite
        WHERE user_id = #{userId}
          AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
