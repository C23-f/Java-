<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.DistrictMapper">

    <!-- 查询全部街道（boundary 为边界GeoJSON，单独查避免列表过大） -->
    <select id="selectAll" resultType="com.example.springboot.entity.District">
        SELECT id, name FROM district ORDER BY id
    </select>

    <!-- 根据ID查询街道（含边界GeoJSON） -->
    <select id="selectById" resultType="com.example.springboot.entity.District">
        SELECT id, name, boundary FROM district WHERE id = #{id}
    </select>

    <!-- 新增街道 -->
    <insert id="insert" parameterType="com.example.springboot.entity.District" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO district(name, boundary) VALUES(#{name}, #{boundary})
    </insert>

    <!-- 修改街道 -->
    <update id="update" parameterType="com.example.springboot.entity.District">
        UPDATE district
        SET name = #{name},
            boundary = #{boundary}
        WHERE id = #{id}
    </update>

    <!-- 删除街道 -->
    <delete id="deleteById">
        DELETE FROM district WHERE id = #{id}
    </delete>

</mapper>
